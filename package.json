{
  "name": "omar.mov",
  "version": "0.0.0",
  "type": "module",
  "repository": "github:o-az/omar.mov",
  "imports": {
    "#*": "./src/*",
    "#package.json": "./package.json",
    "#wrangler.json": "./wrangler.json"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler --config='wrangler.json' deploy",
    "build:types": "wrangler types --env-interface CloudflareBindings",
    "check": "biome check . --write --unsafe",
    "check:types": "bun tsgo --project tsconfig.json --noEmit",
    "up": "bun x taze@latest --recursive --update major"
  },
  "dependencies": {
    "@tanstack/solid-router": "^1.139.14",
    "@tanstack/solid-start": "^1.139.14",
    "cva": "^1.0.0-beta.4",
    "powerglitch": "^2.5.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@cloudflare/vite-plugin": "^1.17.0",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/colorized-brackets": "^3.19.0",
    "@shikijs/rehype": "^3.19.0",
    "@shikijs/transformers": "^3.19.0",
    "@shikijs/twoslash": "^3.19.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/devtools-vite": "^0.3.11",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.3",
    "@types/node": "^24.10.1",
    "@typescript/native-preview": "^7.0.0-dev.20251205.1",
    "eruda": "^3.4.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-meta": "^4.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "solid-js": "^1.9.10",
    "solid-jsx": "^1.1.4",
    "string-width": "^8.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "typed-query-selector": "^2.12.0",
    "typescript": "^5.9.3",
    "unplugin-info": "^1.2.4",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-solid": "^2.11.10",
    "wrangler": "^4.53.0"
  },
  "overrides": {
