{
  "$schema": "https://esm.sh/wrangler/config-schema.json",
  "name": "omar-mov",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./src/server.ts",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "persist": true,
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
